# Neon Postgres connection string (get it from https://neon.tech -> your project -> Connection Details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk keys (get them from https://dashboard.clerk.com -> your app -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: canonical site URL used in metadata (OG tags, sitemap, robots).
# Rarely needed: on Vercel it resolves automatically (production custom domain,
# or the deployment URL on previews). Set it only to force a different origin.
NEXT_PUBLIC_SITE_URL=

# PostHog product analytics (https://app.posthog.com -> Project settings -> API Keys)
# Optional: the app works without them; events are silently skipped if absent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: dev/prod/preview. Leave empty to disable local analytics; set on Vercel for preview/prod.
NEXT_PUBLIC_POSTHOG_ENV=
